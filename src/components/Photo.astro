---
// 사진 하나 + 밑에 한 줄. 원본을 src/assets/ 에 두면 Astro가 알아서 줄여 내보냅니다.
// 사용: 글 머리말(frontmatter)의 photos 에 적으면 됩니다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  caption?: string;
  alt?: string;
}
const { src, caption, alt } = Astro.props;

// 원본보다 크게 늘리지 않습니다. 옛 사진은 작은 것이 많아서.
const widths = [...new Set([480, 800, 1200].filter((w) => w < src.width)), src.width];
---
<figure class="photo">
  <Image src={src} alt={alt ?? caption ?? ''} widths={widths} sizes="(max-width: 40rem) 100vw, 34rem" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
