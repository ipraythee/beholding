---
// Vimeo·YouTube 임베드. 파일을 직접 올리지 않고 원본 플랫폼에 그대로 둡니다.
// 사용: <VideoEmbed provider="vimeo" id="12345678" caption="북아현동, 2012" />
interface Props {
  provider: 'vimeo' | 'youtube';
  id: string;
  caption?: string;
}
const { provider, id, caption } = Astro.props;
const src = provider === 'vimeo'
  ? `https://player.vimeo.com/video/${id}`
  : `https://www.youtube-nocookie.com/embed/${id}`;
---
<figure class="embed">
  <div class="frame">
    <iframe src={src} loading="lazy" title={caption ?? '영상'}
      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
