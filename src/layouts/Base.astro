---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;   // 글마다 다른 설명. 없으면 아래 기본 설명이 쓰입니다.
}
const { title, description } = Astro.props;

const siteName = '바라봄';
const siteDescription =
  '눈이 멀었다가 지금은 보게 되었다. 사진과 영상, 영적 여정과 이주민 곁의 기록 — 2012년부터 이어온 바라봄의 아카이브.';

const pageTitle = title ? `${title} — ${siteName}` : siteName;
const desc = description && description.length > 0 ? description : siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);   // 카톡·페북 카드에 뜰 그림. public/og.png
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- 카카오톡·페이스북에 링크를 붙였을 때 뜨는 카드 -->
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="바라봄 — 다만 한 가지 내가 아는 것은, 내가 눈이 멀었다가, 지금은 보게 되었다는 것입니다." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />

    <!-- 명조 웹폰트. 원하면 주석 풀어 쓰세요. 한글 폰트는 무거우니 나중에 최적화. -->
    <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700&display=swap" rel="stylesheet" /> -->
  </head>
  <body>
    <header class="masthead">
      <p class="name"><a href="/">바라봄</a></p>
      <p class="motto">다만 한 가지 내가 아는 것은,<br />내가 눈이 멀었다가, 지금은 보게 되었다는 것입니다.</p>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <p class="mark">— 바라봄 —</p>
      <p class="contact"><a href="mailto:ipraythee@gmail.com">ipraythee@gmail.com</a></p>
    </footer>
  </body>
</html>
